# ============================================================
# AI Immigration Platform — Local Development Environment
# WARNING: Do not store real production secrets in this file.
# ============================================================

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://ai_immigration:local_dev_only@localhost:5432/ai_immigration

# Background Jobs / Redis
REDIS_URL=redis://localhost:6379/0

# Private Immutable Object Storage (MinIO / S3)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ai-immigration
USE_LOCAL_STORAGE=false
DOCUMENT_STORAGE_DIR=./storage_data

# Security & Session Authentication
JWT_SECRET_KEY=change_this_to_a_random_32_byte_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External OIDC Provider (Optional in dev, required in production enterprise)
AUTH_REQUIRED=false
AUTH_ISSUER_URL=
AUTH_AUDIENCE=ai-immigration-api

# Network & Rate Limiting
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120
